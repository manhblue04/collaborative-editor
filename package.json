{
  "name": "collaborative-editor",
  "version": "1.0.0",
  "private": true,
  "description": "Real-time collaborative document editor (Google Docs lite) using TipTap, Yjs, React and Express.",
  "scripts": {
    "install:all": "npm install && npm --prefix backend install && npm --prefix frontend install",
    "dev": "concurrently -n backend,frontend -c blue,magenta \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:host": "concurrently -n backend,frontend -c blue,magenta \"npm:dev:backend\" \"npm:dev:frontend:host\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:frontend:host": "npm --prefix frontend run dev:host",
    "build:frontend": "npm --prefix frontend run build",
    "start": "npm --prefix backend run start"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
