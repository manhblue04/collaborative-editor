# ============================================================
#  ENV TEMPLATE  —  Sao chép file này thành:
#    .env.development   →  cho local dev
#    .env.production    →  cho production build
#  Không điền giá trị thật vào file này.
# ============================================================

# URL của backend REST API
VITE_API_URL=http://localhost:3001

# URL của WebSocket server (Yjs)
# Dev:  ws://localhost:3001/yjs
# Prod: wss://api.yourdomain.com/yjs   ← dùng wss:// (TLS) trên production
VITE_WS_URL=ws://localhost:3001/yjs
