# ============================================================
#  ENV TEMPLATE  —  Sao chép file này thành:
#    .env.development   →  cho local dev
#    .env.production    →  cho production
#  Không điền giá trị thật vào file này.
# ============================================================

NODE_ENV=development

# --- Server ---
PORT=3001

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017/collaborative-editor

# --- JWT ---
# Tạo secret mạnh: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- CORS ---
CORS_ORIGIN=http://localhost:5173
