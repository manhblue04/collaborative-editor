NODE_ENV=production

# --- Server ---
PORT=3001

# --- MongoDB ---
# Dùng MongoDB Atlas hoặc URI của server production
MONGODB_URI=mongodb+srv://bluecode304_db_user:3k8iFuF90u6priJq@bluecode.on8wt2p.mongodb.net/collaborative-editor?appName=BlueCode

# --- JWT ---
# Dùng một chuỗi ngẫu nhiên dài, bảo mật (>= 32 ký tự)
# Tạo bằng: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d

# --- CORS ---
# Domain production của frontend
CORS_ORIGIN=http://collab.blue304.shop
